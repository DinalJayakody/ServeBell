{
  "name": "@servebell/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed HTTP client for the ServeBell API, shared by both mobile apps and the QR web app.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@servebell/shared": "workspace:*"
  },
  "devDependencies": {
    "@servebell/config": "workspace:*",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
