# Leave EXPO_PUBLIC_API_URL empty in development: the app uses the LAN address
# Expo Go loaded from (e.g. http://192.168.1.5:4000). Set it for tunnels/production.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_PORT=4000

# Supabase Auth. Leave both empty in development to use the local stack (`pnpm dev:supabase`).
# Builds: Supabase dashboard → Project Settings → API (Project URL) and API Keys (publishable key).
# Only the PUBLISHABLE key belongs here — never the secret key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google sign-in (requires a development build; see docs/testing/expo-go.md)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
