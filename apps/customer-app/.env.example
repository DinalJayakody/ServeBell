# Leave EXPO_PUBLIC_API_URL empty in development: the app uses the LAN address
# Expo Go loaded from (e.g. http://192.168.1.5:4000). Set it for tunnels/production.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_PORT=4000

# Leave all EXPO_PUBLIC_FIREBASE_* empty to use the local Auth emulator (`pnpm dev:auth`).
# For a real Firebase project: Project settings → Your apps → Web app config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Optional override of the emulator host (defaults to the dev machine, port 9099).
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=

# Google sign-in (requires a development build; see docs/testing/expo-go.md)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
