{
  "expo": {
    "name": "ServeBell",
    "slug": "servebell-customer",
    "scheme": "servebell",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A1428",
    "ios": {
      "bundleIdentifier": "app.servebell.customer",
      "supportsTablet": false,
      "usesAppleSignIn": true
    },
    "android": {
      "package": "app.servebell.customer",
      "adaptiveIcon": {
        "backgroundColor": "#0A1428",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0A1428"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ServeBell uses your location to show restaurants near you."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ServeBell uses the camera to scan table QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ServeBell needs photo access to set your profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2F74FF"
        }
      ],
      "expo-asset",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}
