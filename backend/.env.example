# ── Runtime ──
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (QR web). Mobile apps are not subject to CORS.
CORS_ORIGINS=http://localhost:3000
# Public base URL used inside generated QR codes (points at the QR web app).
PUBLIC_WEB_URL=http://localhost:3000

# ── Database ──
DATABASE_URL=postgresql://servebell:servebell_dev_password@localhost:5432/servebell?schema=public

# ── Auth: Firebase Authentication ──
# Development default: the local Auth emulator (`pnpm dev:auth`) with the offline
# "demo-servebell" project — no Firebase account needed. For a real project, set
# its Project ID here and clear FIREBASE_AUTH_EMULATOR_HOST.
FIREBASE_PROJECT_ID=demo-servebell
# Optional. base64 of a service-account JSON (Project settings → Service accounts).
# Enables revoked-token checks and admin user operations. Never commit the JSON.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Development only: verify tokens issued by the local Auth emulator (refused in production).
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Pepper for invitation-code hashes (generate with: openssl rand -base64 48).
TOKEN_HASH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ── Cloudflare R2 (S3-compatible). Leave empty in dev to use local disk storage. ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ── Email (employee invitations; password reset emails are sent by Firebase). Empty = log to console in development. ──
SMTP_URL=
MAIL_FROM="ServeBell <no-reply@servebell.app>"

# ── Push ──
EXPO_ACCESS_TOKEN=

# ── Dev seeding: demo accounts are only created when this is true AND NODE_ENV != production ──
SEED_DEMO_ACCOUNTS=true
