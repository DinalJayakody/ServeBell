# ── Runtime ──
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (QR web). Mobile apps are not subject to CORS.
CORS_ORIGINS=http://localhost:3000
# Public base URL used inside generated QR codes (points at the QR web app).
PUBLIC_WEB_URL=http://localhost:3000

# ── Database ──
DATABASE_URL=postgresql://servebell:servebell_dev_password@localhost:5432/servebell?schema=public

# ── Auth: Supabase Auth ──
# Development default: the local Supabase stack (`pnpm dev:supabase`, i.e. `supabase start`).
# Production: Project Settings → API → Project URL, and API Keys → secret key (server only, never in the apps).
SUPABASE_URL=http://127.0.0.1:54321
# Local stack: copy SECRET_KEY from `supabase status -o env`.
SUPABASE_SECRET_KEY=

# Pepper for invitation-code hashes (generate with: openssl rand -base64 48).
TOKEN_HASH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ── Cloudflare R2 (S3-compatible). Leave empty in dev to use local disk storage. ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ── Email (employee invitations; sign-up and password-reset emails are sent by Supabase Auth). Empty = log to console in development. ──
SMTP_URL=
MAIL_FROM="ServeBell <no-reply@servebell.app>"

# ── Push ──
EXPO_ACCESS_TOKEN=

# ── Dev seeding: demo accounts are only created when this is true AND NODE_ENV != production ──
SEED_DEMO_ACCOUNTS=true
