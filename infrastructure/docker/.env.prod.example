# ── Postgres ──
POSTGRES_USER=servebell
POSTGRES_PASSWORD=   # openssl rand -base64 32
POSTGRES_DB=servebell
BACKUP_KEEP_DAYS=14

# ── API ──
PORT=4000
# Both are https://<SITE_ADDRESS>
CORS_ORIGINS=
PUBLIC_WEB_URL=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_BASE64=
TOKEN_HASH_SECRET=   # openssl rand -base64 48
SMTP_URL=
MAIL_FROM="ServeBell <no-reply@servebell.app>"
EXPO_ACCESS_TOKEN=
# Optional: "Detect tables from a photo" in the floor-plan editor (Anthropic API key, pay-per-use).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
SEED_DEMO_ACCOUNTS=false

# ── Web ──
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# ── HTTPS (Caddy, automatic Let's Encrypt) ──
# No domain? Use your server IP with dashes + .sslip.io, e.g. 129-146-1-2.sslip.io (free, no signup).
SITE_ADDRESS=
ACME_EMAIL=
